{
  "node_id": 1,
  "data_dir": "data/node1",
  "log_level": "info",
  "log_file": "logs/node1.log",
  "storage": {
    "segment_size_bytes": 67108864,
    "flush_mode": "per_write",
    "batch_flush_interval_ms": 10,
    "index_max_entries": 1000000,
    "compaction_enabled": true,
    "compaction_interval_s": 60,
    "compaction_threshold_ratio": 0.5
  },
  "network": {
    "listen_host": "127.0.0.1",
    "listen_port": 7100,
    "max_connections": 128,
    "max_outstanding_io": 4096,
    "max_frame_size": 1048576,
    "recv_buffer_size": 65536,
    "send_buffer_size": 65536,
    "io_threads": 4,
    "worker_threads": 4,
    "connect_timeout_ms": 5000
  },
  "replication": {
    "replication_factor": 1,
    "partition_count": 1,
    "consistency_level": "one",
    "peers": [
      { "node_id": 1, "host": "127.0.0.1", "port": 7100 }
    ]
  },
  "limits": {
    "max_concurrent_scans": 32,
    "max_key_size": 1024,
    "max_payload_size": 1048576,
    "max_scan_results": 100000
  }
}
